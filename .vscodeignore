# Source and build tooling - not needed in the packaged extension
src/**
scripts/**
node_modules/**
dist/**/*.map
.vscode/**
.vscode-test/**
out/**

# Config files
tsconfig.json
webpack.config.js
eslint.config.js
jest.config.js
.prettierrc
.prettierignore
.gitignore
.husky/**
.github/**

# TypeScript source maps
**/*.map
**/*.ts
!**/*.d.ts

# README images are served from GitHub, not the VSIX
docs/**

