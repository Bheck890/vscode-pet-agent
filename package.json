{
  "name": "vscode-peon-pet",
  "displayName": "Peon Pet",
  "description": "A pixel pet (cat, dog, bird or fox) that acts out what your AI coding agent is doing. Sub-agents spawn mini pets.",
  "version": "0.2.0",
  "publisher": "smcqueen",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/smcqueen2/vscode-peon-pet"
  },
  "homepage": "https://github.com/smcqueen2/vscode-peon-pet#readme",
  "bugs": {
    "url": "https://github.com/smcqueen2/vscode-peon-pet/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "ai",
    "agent",
    "claude",
    "claude-code",
    "peon-ping",
    "pixel-art",
    "cat",
    "dog",
    "fox",
    "fun"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:peonPetView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "peonPetView",
          "name": "Agent Pet"
        }
      ]
    },
    "commands": [
      {
        "command": "peon-pet.customize",
        "title": "Peon Pet: Customize Pet"
      }
    ],
    "configuration": {
      "title": "Peon Pet",
      "properties": {
        "peon-pet.species": {
          "type": "string",
          "enum": [
            "cat",
            "dog",
            "bird",
            "fox"
          ],
          "default": "cat",
          "description": "Which animal your pet is."
        },
        "peon-pet.color": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fur/feather colour. Any CSS colour (`#ff8800`, `hotpink`, `rebeccapurple`...). Leave empty for the species default. Your AI agent can change this for you by editing your VS Code settings."
        },
        "peon-pet.name": {
          "type": "string",
          "default": "",
          "description": "Your pet's name. Leave empty for the species default."
        },
        "peon-pet.stateColors": {
          "type": "boolean",
          "default": true,
          "description": "Tint the pet and glow a coloured aura that changes with what the agent is doing."
        },
        "peon-pet.size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "enumDescriptions": [
            "150px",
            "200px",
            "250px"
          ],
          "default": "medium",
          "description": "Sprite display size."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "webpack --mode production && npx @vscode/vsce package --no-dependencies",
    "lint": "eslint src media",
    "lint:fix": "eslint src media --fix",
    "format": "prettier --write \"src/**/*.ts\" \"media/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"media/**/*.{js,css,html}\"",
    "test": "jest",
    "pretest": "npm run lint && npm run compile",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "jest": "^30.2.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  }
}
